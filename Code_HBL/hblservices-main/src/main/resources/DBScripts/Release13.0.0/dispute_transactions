CREATE TABLE `disputeTransactions` (
  `id` varchar(50) NOT NULL,
  `Customer_id` varchar(50) NOT NULL,
  `amount` varchar(50) NOT NULL,
  `description` varchar(100) NOT NULL,
  `fromAccountName` varchar(50) NOT NULL,
  `fromAccountNumber` varchar(50) NOT NULL,
  `transactionDate` varchar(50) NOT NULL,
  `transactionId` varchar(50) NOT NULL,
  `transactionsNotes` varchar(50) NOT NULL,
  `transactionType` varchar(50) NOT NULL,
  `disputeReason` varchar(50) NOT NULL,
  `disputeStatus` varchar(50) NOT NULL,
  `remarks` varchar(50) NOT NULL,
  `serviceReqId` varchar(50) NOT NULL,
  `serviceReqProcessedTime` varchar(50) NOT NULL,
  `serviceReqStatus` varchar(50) NOT NULL,
  `createdby` varchar(50) DEFAULT NULL,
  `modifiedby` varchar(50) DEFAULT NULL,
  `createdts` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `lastmodifiedts` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  `lastsynctimestamp` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  `softdeleteflag` tinyint(1) NOT NULL DEFAULT '0',
  PRIMARY KEY (`id`),
  KEY `FK_Cust_id_idx` (`Customer_id`),
  CONSTRAINT `FK_Custr_id` FOREIGN KEY (`Customer_id`) REFERENCES `customer` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3




