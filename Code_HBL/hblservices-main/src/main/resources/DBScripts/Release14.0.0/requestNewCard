CREATE TABLE `requestnewcard` (
  `id` varchar(50) NOT NULL,
  `customerId` varchar(50) NOT NULL,
  `coreIdentifier` varchar(50) NOT NULL,
  `cardType` varchar(50) DEFAULT NULL,
  `debitAccount` varchar(50) DEFAULT NULL,
  
  `serviceProvider` varchar(50) DEFAULT NULL,
  `cardDescription` varchar(1000) DEFAULT NULL,
  `dailyWithdrawLimit` varchar(20) DEFAULT NULL,
  `dailyPurchaseLimit` varchar(20) DEFAULT NULL,
  `annualFee` varchar(20) DEFAULT NULL,
  `nameOnTheCard` varchar(50) DEFAULT NULL,
  `referenceNumber` varchar(50) DEFAULT NULL,
  `cardCategory` varchar(50) DEFAULT NULL,
  `cardFee` varchar(20) DEFAULT NULL,
  `panNo` varchar(20) DEFAULT NULL,
  `topupAmount` varchar(20) DEFAULT NULL,
  `totalDebitAmount` varchar(20) DEFAULT NULL,
  `requestdate` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `createdts` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `lastmodifiedts` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  `lastsynctimestamp` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  `softdeleteflag` tinyint(1) NOT NULL DEFAULT '0',
  PRIMARY KEY (`id`),
  KEY `FK_Cust_id_idcc` (`customerId`),
  CONSTRAINT `FK_Cust_id_idcc` FOREIGN KEY (`customerId`) REFERENCES `customer` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3

